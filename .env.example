# Copy to .env for local dev. Never commit the real key.
ANTHROPIC_API_KEY=

# Optional: shared rate-limit storage (Upstash Redis via the Vercel Marketplace).
# Without these, limits are counted per serverless instance, which is weaker.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override Pip's limits (defaults shown).
# PIP_BURST_LIMIT=15          # messages per visitor per 10 minutes
# PIP_VISITOR_DAILY_LIMIT=60  # messages per visitor per day
# PIP_SITE_DAILY_LIMIT=400    # messages across ALL visitors per day
